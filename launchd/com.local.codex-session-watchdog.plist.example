<?xml version="1.0" encoding="UTF-8"?>
<!-- 用法：复制到 ~/Library/LaunchAgents/，把 __REPO__ 换成本仓库的实际路径，
     然后执行 launchctl load -w ~/Library/LaunchAgents/<文件名>.plist        -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.local.codex-session-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/watchdog.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartInterval</key><integer>90</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__REPO__/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__REPO__/launchd.err.log</string>
</dict>
</plist>
